GOOGLE_CLIENT_ID=your-web-oauth-client-id
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
SUPABASE_DATABASE_PASSWORD=your-supabase-database-password
SUPABASE_DATABASE_CONNECTION_STRING=postgresql://postgres:password@host:5432/postgres?sslmode=require
PORT=3000
# For production, set this to your HTTPS site origin, without a trailing slash.
APP_BASE_URL=http://localhost:3000
